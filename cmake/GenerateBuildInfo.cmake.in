set(SOURCE_DIR "@PROJECT_SOURCE_DIR@")
set(OUTPUT_FILE "@EPYCBENCH_BUILD_INFO_HEADER@")
set(HEADER_TEMPLATE "@PROJECT_SOURCE_DIR@/cmake/BuildInfoGenerated.hpp.in")

set(PROJECT_VERSION "@PROJECT_VERSION@")
set(COMPILER_ID "@CMAKE_CXX_COMPILER_ID@")
set(COMPILER_VERSION "@CMAKE_CXX_COMPILER_VERSION@")
set(COMPILER_TARGET "@EPYCBENCH_COMPILER_TARGET@")
set(COMPILER_FLAGS "@EPYCBENCH_MANIFEST_COMPILER_FLAGS@")
set(LINKER_ID "@EPYCBENCH_LINKER_ID@")
set(LINKER_VERSION "@EPYCBENCH_LINKER_VERSION@")
set(BUILD_PRESET "@EPYCBENCH_BUILD_PRESET@")

set(FEATURE_TESTING "@EPYCBENCH_FEATURE_TESTING@")
set(FEATURE_ASAN_UBSAN "@EPYCBENCH_FEATURE_ASAN_UBSAN@")
set(FEATURE_TSAN "@EPYCBENCH_FEATURE_TSAN@")
set(FEATURE_NATIVE_REFERENCE "@EPYCBENCH_FEATURE_NATIVE_REFERENCE@")

set(HWLOC_VERSION "@EPYCBENCH_DEPENDENCY_HWLOC_VERSION@")
set(NUMA_VERSION "@EPYCBENCH_DEPENDENCY_NUMA_VERSION@")
set(LIBFYAML_VERSION "@EPYCBENCH_DEPENDENCY_LIBFYAML_VERSION@")
set(CLI11_VERSION "@EPYCBENCH_DEPENDENCY_CLI11_VERSION@")
set(NLOHMANN_JSON_VERSION "@EPYCBENCH_DEPENDENCY_NLOHMANN_JSON_VERSION@")
set(FMT_VERSION "@EPYCBENCH_DEPENDENCY_FMT_VERSION@")
set(CATCH2_VERSION "@EPYCBENCH_DEPENDENCY_CATCH2_VERSION@")

execute_process(
    COMMAND "@GIT_EXECUTABLE@" rev-parse --show-toplevel
    WORKING_DIRECTORY "${SOURCE_DIR}"
    RESULT_VARIABLE GIT_TOPLEVEL_RESULT
    OUTPUT_VARIABLE GIT_TOPLEVEL
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
)
set(GIT_SOURCE_ROOT_MATCHES false)
if(GIT_TOPLEVEL_RESULT EQUAL 0 AND IS_DIRECTORY "${GIT_TOPLEVEL}")
    file(REAL_PATH "${SOURCE_DIR}" SOURCE_DIR_REAL)
    file(REAL_PATH "${GIT_TOPLEVEL}" GIT_TOPLEVEL_REAL)
    if(SOURCE_DIR_REAL STREQUAL GIT_TOPLEVEL_REAL)
        set(GIT_SOURCE_ROOT_MATCHES true)
    endif()
endif()

# An unpacked source tree must not inherit an enclosing repository's identity.
set(GIT_REVISION "unknown")
set(GIT_DIRTY true)
if(GIT_SOURCE_ROOT_MATCHES)
    execute_process(
        COMMAND "@GIT_EXECUTABLE@" rev-parse HEAD
        WORKING_DIRECTORY "${SOURCE_DIR}"
        RESULT_VARIABLE GIT_REVISION_RESULT
        OUTPUT_VARIABLE GIT_REVISION
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
    )
    if(NOT GIT_REVISION_RESULT EQUAL 0)
        set(GIT_REVISION "unknown")
    endif()

    execute_process(
        COMMAND "@GIT_EXECUTABLE@" status --porcelain --untracked-files=normal
        WORKING_DIRECTORY "${SOURCE_DIR}"
        RESULT_VARIABLE GIT_STATUS_RESULT
        OUTPUT_VARIABLE GIT_STATUS
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
    )
    if(GIT_STATUS_RESULT EQUAL 0 AND GIT_STATUS STREQUAL "")
        set(GIT_DIRTY false)
    endif()
endif()

set(
    BUILD_IDENTITY_INPUT
    "${PROJECT_VERSION}|${GIT_REVISION}|${GIT_DIRTY}|${COMPILER_ID}|${COMPILER_VERSION}|${COMPILER_TARGET}|${COMPILER_FLAGS}|${LINKER_ID}|${LINKER_VERSION}|${BUILD_PRESET}|${FEATURE_TESTING}|${FEATURE_ASAN_UBSAN}|${FEATURE_TSAN}|${FEATURE_NATIVE_REFERENCE}|${HWLOC_VERSION}|${NUMA_VERSION}|${LIBFYAML_VERSION}|${CLI11_VERSION}|${NLOHMANN_JSON_VERSION}|${FMT_VERSION}|${CATCH2_VERSION}"
)
string(SHA256 BUILD_IDENTITY "${BUILD_IDENTITY_INPUT}")

foreach(
    variable
    IN ITEMS
        PROJECT_VERSION
        GIT_REVISION
        COMPILER_ID
        COMPILER_VERSION
        COMPILER_TARGET
        COMPILER_FLAGS
        LINKER_ID
        LINKER_VERSION
        BUILD_PRESET
        BUILD_IDENTITY
        HWLOC_VERSION
        NUMA_VERSION
        LIBFYAML_VERSION
        CLI11_VERSION
        NLOHMANN_JSON_VERSION
        FMT_VERSION
        CATCH2_VERSION
)
    string(REPLACE "\\" "\\\\" "${variable}" "${${variable}}")
    string(REPLACE "\"" "\\\"" "${variable}" "${${variable}}")
    string(REPLACE "\n" "\\n" "${variable}" "${${variable}}")
endforeach()

get_filename_component(OUTPUT_DIRECTORY "${OUTPUT_FILE}" DIRECTORY)
file(MAKE_DIRECTORY "${OUTPUT_DIRECTORY}")
set(TEMPORARY_FILE "${OUTPUT_FILE}.tmp")
configure_file("${HEADER_TEMPLATE}" "${TEMPORARY_FILE}")
execute_process(
    COMMAND "@CMAKE_COMMAND@" -E copy_if_different "${TEMPORARY_FILE}" "${OUTPUT_FILE}"
    COMMAND_ERROR_IS_FATAL ANY
)
file(REMOVE "${TEMPORARY_FILE}")
