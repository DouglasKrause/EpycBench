  if (auto r=write_scalar__provenance__resolved_plan_digest(writer, value.resolved_plan_digest, selected_branch_token); !r) return r;
  if (auto r=writer.append_literal(",\"scenario_digest\":"); !r) return r;
  if (auto r=write_scalar__provenance__scenario_digest(writer, value.scenario_digest, selected_branch_token); !r) return r;
  if (auto r=writer.append_literal(",\"scenario_profile\":"); !r) return r;
  if (auto r=write_scalar__provenance__scenario_profile(writer, value.scenario_profile, selected_branch_token); !r) return r;
  if (auto r=writer.append_literal(",\"second_variant_id\":"); !r) return r;
  if (auto r=write_scalar__provenance__second_variant_id(writer, value.second_variant_id, selected_branch_token); !r) return r;
  if (auto r=writer.append_literal(",\"workload_id\":"); !r) return r;
  if (auto r=write_scalar__provenance__workload_id(writer, value.workload_id, selected_branch_token); !r) return r;
  return writer.append_literal("}");
  }
}
