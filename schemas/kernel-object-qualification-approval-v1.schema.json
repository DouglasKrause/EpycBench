{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "epycbench.kernel-object-qualification-approval/v1",
  "title": "Historical Kernel object qualification approval v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "epycbench.kernel-object-qualification-approval/v1"
    },
    "framework_version": {
      "const": "epycbench.kernel-object-audit/v1"
    },
    "policy_version": {
      "type": "string"
    },
    "report_schema": {
      "const": "epycbench.kernel-object-audit-report/v1"
    },
    "implementation_id": {
      "type": "string"
    },
    "issue": {
      "type": "string"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "minLength": 40,
      "maxLength": 40
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "approval": {
      "type": "object",
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "recorded_at_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
          "minLength": 20,
          "maxLength": 20
        },
        "disposition": {
          "const": "approved"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "semantic_items": {
          "type": "array"
        }
      },
      "required": [
        "actor",
        "recorded_at_utc",
        "disposition",
        "statement",
        "semantic_items"
      ],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "object",
          "properties": {
            "automated_disposition": {
              "const": "pass"
            },
            "compiler_family": {
              "const": "GCC"
            },
            "function_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "generated_human_review_status": {
              "const": "pending"
            },
            "human_report": {
              "type": "object",
              "properties": {
                "path": {
                  "const": "gcc/object-code-audit.txt"
                },
                "sha256": {
                  "$ref": "#/$defs/sha256"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            },
            "machine_report": {
              "type": "object",
              "properties": {
                "path": {
                  "const": "gcc/object-code-audit.json"
                },
                "sha256": {
                  "$ref": "#/$defs/sha256"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            },
            "object_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "qualification_preset": {
              "const": "release"
            }
          },
          "required": [
            "automated_disposition",
            "compiler_family",
            "function_sha256",
            "generated_human_review_status",
            "human_report",
            "machine_report",
            "object_sha256",
            "qualification_preset"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "automated_disposition": {
              "const": "pass"
            },
            "compiler_family": {
              "const": "Clang"
            },
            "function_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "generated_human_review_status": {
              "const": "pending"
            },
            "human_report": {
              "type": "object",
              "properties": {
                "path": {
                  "const": "clang/object-code-audit.txt"
                },
                "sha256": {
                  "$ref": "#/$defs/sha256"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            },
            "machine_report": {
              "type": "object",
              "properties": {
                "path": {
                  "const": "clang/object-code-audit.json"
                },
                "sha256": {
                  "$ref": "#/$defs/sha256"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            },
            "object_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "qualification_preset": {
              "const": "release-clang"
            }
          },
          "required": [
            "automated_disposition",
            "compiler_family",
            "function_sha256",
            "generated_human_review_status",
            "human_report",
            "machine_report",
            "object_sha256",
            "qualification_preset"
          ],
          "additionalProperties": false
        }
      ],
      "items": false
    }
  },
  "required": [
    "schema",
    "framework_version",
    "policy_version",
    "report_schema",
    "implementation_id",
    "issue",
    "source_commit",
    "title",
    "approval",
    "artifacts"
