  auto emit = [&]<class V>(const V& converted_value) noexcept -> WriteResult {
    if (auto r=writer.append_literal("\""); !r) return r;
    if (auto r=writer.append_unsigned(converted_value); !r) return r;
    return writer.append_literal("\"");
  };
  if constexpr (std::same_as<bare_t<T>, epycbench::monitoring::PageFaultCount>) return emit(static_cast<std::uint64_t>(value.value()));
  else if constexpr (std::same_as<bare_t<T>, epycbench::monitoring::ContextSwitchCount>) return emit(static_cast<std::uint64_t>(value.value()));
  else if constexpr (std::same_as<bare_t<T>, epycbench::monitoring::TemperatureRangeMilliCelsius>) return emit(static_cast<std::uint64_t>(value.value()));
  else if constexpr (std::same_as<bare_t<T>, std::uint64_t>) return emit(static_cast<std::uint64_t>(value));
  else return writer.reject_domain();
}
