template<class T> auto write_provenance(PreparedCanonicalWriter& writer, const T& value, std::string_view selected_branch_token) noexcept -> WriteResult {
  static_cast<void>(selected_branch_token);
  static_cast<void>(value);
  if constexpr (requires { value.has_value(); }) { if (!value) return writer.append_literal("null"); else return write_provenance(writer, *value, selected_branch_token); }
  else {
  if (auto r=writer.append_literal("{"); !r) return r;
  if (auto r=writer.append_literal("\"experiment_id\":"); !r) return r;
  if (auto r=write_scalar__provenance__experiment_id(writer, value.experiment_id, selected_branch_token); !r) return r;
  if (auto r=writer.append_literal(",\"first_variant_id\":"); !r) return r;
  if (auto r=write_scalar__provenance__first_variant_id(writer, value.first_variant_id, selected_branch_token); !r) return r;
